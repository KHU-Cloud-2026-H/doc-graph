#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY="032ae4411cb6d51e715edc796093106bba94afd9dbce109244f8dffde8682db477"

#/----------------------------------------------------------/
#/                평문 default (인프라/팀 공유)                /
#/----------------------------------------------------------/
POSTGRES_VERSION=17

# 호스트 포트 매핑. 불용시 .env.local에서 override.
NGROK_HOST_PORT=4040
POSTGRES_HOST_PORT=5433
POSTGRES_TEST_HOST_PORT=5434
BACKEND_HOST_PORT=8080
WIREMOCK_HOST_PORT=8081

# ngrok static domain (팀 공유). ngrok dashboard에서 reserve.
# 무료 플랜 동시 1 endpoint — 충돌 시 .env.local에 본인 토큰·도메인 override.
# Notion connection settings의 webhook URL은 이 도메인 기준 1회 등록.
NGROK_STATIC_DOMAIN=curfew-eskimo-subtype.ngrok-free.dev

DB_URL=jdbc:postgresql://localhost:${POSTGRES_HOST_PORT}/docgraph
DB_USERNAME=docgraph
DB_PASSWORD=simplepwd
AI_OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai
AI_OPENAI_MODEL=gpt-5.4-mini
AI_OPENAI_RESPONSE_FORMAT_ENABLED=false
NOTION_AUTHORIZATION_URI=https://api.notion.com/v1/oauth/authorize
NOTION_TOKEN_URI=https://api.notion.com/v1/oauth/token

# 인수 테스트 endpoint (--env=local-mock|local-live)
ACCEPTANCE_LOCAL_BACKEND_URL=http://localhost:${BACKEND_HOST_PORT}/api
ACCEPTANCE_LOCAL_WIREMOCK_URL=http://localhost:${WIREMOCK_HOST_PORT}

# mock 모드 — backend가 외부 API 대신 wiremock 컨테이너 호출 (docker compose internal hostname)
MOCK_AI_OPENAI_BASE_URL=http://wiremock:8080
MOCK_NOTION_AUTHORIZATION_URI=http://wiremock:8080/notion/oauth/authorize
MOCK_NOTION_TOKEN_URI=http://wiremock:8080/notion/oauth/token

#/----------------------------------------------------------/
#/              팀 공유 시크릿 (dotenvx 암호화)                /
#/         추가/갱신: just encrypt-secret KEY value          /
#/----------------------------------------------------------/
NOTION_CLIENT_ID=encrypted:BBvOdpF1UZNxyj3OyeObsfsCaIOWgZVQZVjByDkwBPTHY3VkdZB340UY8a3iGwmtfL7lCACnzB7TdnIoipqhEXSTdddDJdkELklTyRRwAxOXfMOv2c131pSULWhBkflgAlBRxXWkEua5MyH7dgFq
